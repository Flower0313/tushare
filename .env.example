# Copy to .env and fill real secrets. Never commit .env.

# APP -------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Tushare Data Platform
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# DATABASE --------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tushare:change-me@127.0.0.1:5432/tushare_platform
DATABASE_STATEMENT_TIMEOUT_MS=120000
# Comma-separated schemas whose pre-created tables can receive scheduled SELECT results.
SQL_TASK_ALLOWED_SCHEMAS=analytics,public
POSTGRES_DB=tushare_platform
POSTGRES_USER=tushare
POSTGRES_PASSWORD=change-me

# TUSHARE ---------------------------------------------------------------------
TUSHARE_TOKEN=
# Used to encrypt credentials saved from the Settings page. Use a long random value.
# When omitted, development falls back to DATABASE_URL-derived encryption for local use.
RUNTIME_SECRET_KEY=
TUSHARE_API_BASE_URL=https://api.tushare.pro
TUSHARE_TIMEOUT_SECONDS=30
PREVIEW_ROW_LIMIT=100
PAGINATION_MAX_PAGES=1000

# WORKER ----------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=1
# Development-only convenience. Set false when running python -m app.worker.
RUN_EMBEDDED_WORKER=true
EXECUTION_STALE_TIMEOUT_SECONDS=600
EXECUTION_RECOVERY_POLICY=MANUAL

# SCHEDULER -------------------------------------------------------------------
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_MISFIRE_GRACE_SECONDS=60

# RETRY -----------------------------------------------------------------------
TUSHARE_RETRY_MAX_ATTEMPTS=3
TUSHARE_RETRY_INITIAL_DELAY=1
TUSHARE_RETRY_MAX_DELAY=30
TUSHARE_RETRY_BACKOFF_MULTIPLIER=2
TUSHARE_RETRY_JITTER=0.25
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# RATE LIMIT ------------------------------------------------------------------
TUSHARE_GLOBAL_RATE_REQUESTS=180
TUSHARE_GLOBAL_RATE_PERIOD_SECONDS=60

# DATA LIFECYCLE --------------------------------------------------------------
DELETE_PREVIEW_TTL_SECONDS=600
DELETE_BATCH_THRESHOLD=50000
DELETE_BATCH_SIZE=10000
# Legacy staging compatibility; not the default Replace Range product path.
STAGING_TTL_SECONDS=86400
STAGING_ORPHAN_GRACE_SECONDS=3600
REPLACE_DATASET_TTL_SECONDS=172800

# TRADE CALENDAR --------------------------------------------------------------
TRADE_CALENDAR_BOOTSTRAP_START_YEAR=2010
TRADE_CALENDAR_FUTURE_DAYS=730
TRADE_CALENDAR_WARNING_DAYS=365
TRADE_CALENDAR_CRITICAL_DAYS=90

# HEALTH / MAINTENANCE --------------------------------------------------------
SERVICE_HEARTBEAT_INTERVAL_SECONDS=10
SERVICE_HEARTBEAT_STALE_SECONDS=45
MAINTENANCE_POLL_INTERVAL_SECONDS=15
MAINTENANCE_STAGING_CLEANUP_INTERVAL_SECONDS=300
MAINTENANCE_CALENDAR_INTERVAL_SECONDS=3600

# RETENTION / VALIDATION ------------------------------------------------------
UPSTREAM_HEALTH_RETENTION_DAYS=30
UPSTREAM_HEALTH_ARCHIVE_INTERVAL_SECONDS=86400
PRODUCTION_VALIDATION_MAX_SUBMISSIONS=100

# FRONTEND --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
